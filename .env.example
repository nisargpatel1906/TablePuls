# TablePulse Environment Configuration Template
# Copy to .env and fill in strong generated secrets before running in production.
# NEVER commit .env to version control.

# Application & Routing
TABLEPULSE_ENV=development
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
DEMO_MODE=true

# PostgreSQL 16+ (Native Monthly Partitioning + RLS)
POSTGRES_USER=tablepulse
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=tablepulse
DATABASE_URL=postgresql+asyncpg://tablepulse:change_me_postgres_password@db:5432/tablepulse
PUBLIC_DATABASE_URL=postgresql+asyncpg://tablepulse_public:tablepulse_public_readonly@db:5432/tablepulse

# Valkey 8 (BSD-3 Redis-protocol drop-in)
VALKEY_PASSWORD=change_me_valkey_password
VALKEY_URL=redis://:change_me_valkey_password@valkey:6379/0
REDIS_URL=redis://:change_me_valkey_password@valkey:6379/0

# Cryptographic Keys (generate with: openssl rand -hex 32 / openssl rand -base64 32)
TABLEPULSE_SECRET_KEY=dev_only_replace_with_64_hex_chars_for_jwt_signing_key_00000000
JWT_SECRET=dev_only_replace_with_64_hex_chars_for_jwt_signing_key_00000000
TABLEPULSE_DATA_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
DB_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MEDIAMTX_HOOK_SECRET=dev_only_replace_with_mediamtx_internal_secret

# MediaMTX (RTSP -> WebRTC WHEP, audio stripped)
MEDIAMTX_INTERNAL_URL=rtsp://mediamtx:8554
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889

# CV Worker & ML Runtime
ML_DEVICE=cpu
ML_MODEL_DIR=/app/data/models
SNAPSHOT_STORAGE_DIR=/app/data/snapshots
DEMO_VIDEO_PATH=/app/data/demo/demo_floor.mp4
TARGET_FPS=2
ALLOW_PRIVATE_WEBHOOK_HOSTS=false

# Fail-Closed Safety Kill Switches (missing = false)
AI_INFERENCE_ENABLED=true
WEBHOOKS_ENABLED=false
REVIEW_CROPS_ENABLED=true

# Phase 2 Menu Media & Fail-Closed Feature Flags (missing = false)
MENU_MEDIA_DIR=/app/data/menu-media
TABLE_ADVANCED_ENABLED=true
QR_ENABLED=true
PUBLIC_MENU_ENABLED=true
MENU_IMAGES_ENABLED=true

# Optional SMTP (if blank, UI displays copyable invite & reset links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Frontend Public Runtime Config
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=http://localhost:8889
NEXT_PUBLIC_DEMO_MODE=true
