# Production Deployment Environment Template (see docs/08-security-and-privacy.md)
TABLEPULSE_ENV=production
APP_ENV=production
PUBLIC_APP_URL=https://floor.example.com
ALLOWED_ORIGINS=https://floor.example.com
DEMO_MODE=false

POSTGRES_USER=tablepulse
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=tablepulse
DATABASE_URL=postgresql+asyncpg://tablepulse:REPLACE_WITH_STRONG_PASSWORD@db:5432/tablepulse

VALKEY_PASSWORD=REPLACE_WITH_STRONG_VALKEY_PASSWORD
VALKEY_URL=redis://:REPLACE_WITH_STRONG_VALKEY_PASSWORD@valkey:6379/0
REDIS_URL=redis://:REPLACE_WITH_STRONG_VALKEY_PASSWORD@valkey:6379/0

TABLEPULSE_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
TABLEPULSE_DATA_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
DB_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
MEDIAMTX_HOOK_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

MEDIAMTX_INTERNAL_URL=rtsp://mediamtx:8554
MEDIAMTX_WEBRTC_PUBLIC_URL=https://floor.example.com/webrtc

ML_DEVICE=cpu
ML_MODEL_DIR=/app/data/models
SNAPSHOT_STORAGE_DIR=/app/data/snapshots
ALLOW_PRIVATE_WEBHOOK_HOSTS=false

AI_INFERENCE_ENABLED=false
WEBHOOKS_ENABLED=false
REVIEW_CROPS_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

NEXT_PUBLIC_API_BASE_URL=https://floor.example.com
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=https://floor.example.com/webrtc
NEXT_PUBLIC_DEMO_MODE=false
